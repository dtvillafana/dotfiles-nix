When --render-cursor embeds the cursor in captured frames, do not also
capture and transmit a client-side cursor. Hyprland cursor-image capture
can fail or produce a black square; overlay mode must bypass that path.

diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -2052,6 +2052,9 @@ static bool configure_cursor_sc(struct wayvnc* self,
 
 	struct seat* seat = client->seat;
 	assert(seat);
+
+	if (self->overlay_cursor)
+		return false;
 
 	if (!(seat->capabilities & WL_SEAT_CAPABILITY_POINTER)) {
 		nvnc_log(NVNC_LOG_DEBUG, "Client's seat has no pointer capability");
