@@ -15,6 +15,34 @@
     property string pamState: ""
     property bool unlocking: false

+    // Matches capcu's lock screen. Rapid flashing can trigger photosensitive seizures.
+    readonly property var failureColors: ["#ff0000", "#ff8000", "#ffff00", "#80ff00", "#00ff00", "#00ff80", "#00ffff", "#0080ff", "#0000ff", "#8000ff", "#ff00ff", "#ff0080"]
+    property real failureAngle: 0
+    readonly property bool failing: failureAnimation.running
+    readonly property color failureColor: failureColors[Math.floor(failureAngle / 30) % failureColors.length]
+
+    onPamStateChanged: {
+        if (pamState === "fail" || pamState === "max")
+            failureAnimation.restart();
+    }
+
+    SequentialAnimation {
+        id: failureAnimation
+        NumberAnimation {
+            target: root
+            property: "failureAngle"
+            from: 0
+            to: 1080
+            duration: 3000
+            easing.type: Easing.Linear
+        }
+        PropertyAction {
+            target: root
+            property: "failureAngle"
+            value: 0
+        }
+    }
+
     property var sessionList: []
     property var sessionExecs: []
     property var sessionPaths: []
